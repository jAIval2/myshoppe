FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 app
WORKDIR /srv/myshoppe
COPY backend/requirements.lock /tmp/requirements.lock
RUN pip install --no-cache-dir -r /tmp/requirements.lock
COPY backend /srv/myshoppe/backend
COPY web/public /srv/myshoppe/web/public
RUN mkdir -p /srv/myshoppe/web/public/uploads /srv/myshoppe/.local/media-sources \
    && chown -R app:app /srv/myshoppe
USER app
WORKDIR /srv/myshoppe/backend
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers"]
